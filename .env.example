# Sanity — storefront (read-only, safe to expose to the browser)
# Find these at https://sanity.io/manage → your project → API
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# "true" = serve catalogue queries from Sanity's CDN (faster, ~60s edit lag).
VITE_SANITY_USE_CDN=false
